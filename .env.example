# Environment: development, test, or production
APP_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
SEED_DEMO_DATA=true

# PostgreSQL / Redis. DATABASE_URL is used when running outside Compose.
POSTGRES_DB=margintra
POSTGRES_USER=margintra
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
DATABASE_URL=postgres://margintra:replace-with-a-strong-unique-password@localhost:55434/margintra
REDIS_URL=redis://localhost:6379
# Per API/migration process. Size this against PostgreSQL max_connections; see the runbook.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
INGESTION_WORKER_ENABLED=true
INGESTION_WORKER_INTERVAL_MS=10000
INGESTION_WORKER_BATCH_SIZE=10
INGESTION_WORKER_CLAIM_TIMEOUT_MS=300000
INGESTION_WORKER_MAX_ATTEMPTS=5
INGESTION_WORKER_INITIAL_BACKOFF_MS=1000
INGESTION_WORKER_MAX_BACKOFF_MS=60000
PRICING_REFRESH_ENABLED=true
PRICING_REFRESH_INTERVAL_MS=43200000
PRICING_REFRESH_POLL_INTERVAL_MS=60000
PRICING_REFRESH_CLAIM_TIMEOUT_MS=900000
USAGE_REPLAY_INTERVAL_MS=5000
NOTIFICATION_WORKER_INTERVAL_MS=5000
STRIPE_WEBHOOK_RETRY_INTERVAL_MS=5000

# Authentication
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=Margintra
JWT_AUDIENCE=Margintra.Web

# Stable base64-encoded 32-byte key. Compose maps this to STRIPE_ENCRYPTION_KEY.
BILLING_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
STRIPE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Development defaults to the metadata-only gateway. Production requires resend.
EMAIL_PROVIDER=development
EMAIL_API_KEY=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Margintra
MARGINTRA_DASHBOARD_URL=http://localhost:5173

# Production Compose host binding and immutable image version.
WEB_PORT=8080
IMAGE_TAG=production
